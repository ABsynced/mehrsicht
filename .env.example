# Kopiere diese Datei zu ".env" und trage deine Schlüssel ein.
# Die Datei .env wird NIE auf GitHub hochgeladen (steht in .gitignore).

# ---- KI-Anbieter -------------------------------------------------------
# Reihenfolge: zuerst Groq; wenn dessen Tageslimit erreicht ist,
# übernimmt automatisch Cerebras. Beide sind kostenlos, ohne Kreditkarte.
LLM_PROVIDER=groq,cerebras

# Groq-Schlüssel (beginnt mit gsk_):      https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras-Schlüssel (beginnt mit csk-):  https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Ohne Schlüssel läuft die Seite trotzdem: mit echten Nachrichten,
# aber einfachen Regeln statt KI.

# ---- Fotos -------------------------------------------------------------
# feed    = echte Pressefotos aus den RSS-Feeds der Medien (mit Fotografen-Angabe).
#           Urheberrechtlich geschützt: NUR für die lokale Ansicht auf deinem Computer.
# commons = freie Fotos von Wikimedia Commons (sicher für die öffentliche Website).
# Reihenfolge = Priorität. Lokal:
IMAGE_SOURCE=feed,commons
# Für die öffentliche Website (GitHub) ist automatisch "commons" eingestellt.

# ---- Weitere Dienste (optional) ---------------------------------------
# Google Fact Check Tools API (kostenlos)
FACTCHECK_API_KEY=

# Formular-Adresse deines Newsletter-Anbieters (z. B. Brevo)
NEWSLETTER_FORM_ACTION=

# Adresse der fertigen Website (für Link-Vorschauen)
SITE_URL=https://absynced.github.io/mehrsicht

# Optional: address for "Fehler melden" / "Quelle vorschlagen" links
CONTACT_EMAIL=

# Impressum (required for a public website in Germany). "|" = new line
IMPRESSUM_NAME=
IMPRESSUM_ADDRESS=
